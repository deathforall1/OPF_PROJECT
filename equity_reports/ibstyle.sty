% ======================================================================
%  ibstyle.sty - institutional equity research layout
%  Left column: analytical write-up.  Right column: exhibits.
% ======================================================================
\ProvidesPackage{ibstyle}[2026/08/30 Equity research layout]

\RequirePackage[a4paper,left=13mm,right=13mm,top=19mm,bottom=15mm,
                headsep=4mm,headheight=19pt,footskip=8mm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{helvet}\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{graphicx,xcolor,array,booktabs,colortbl,longtable}
\RequirePackage{titlesec,fancyhdr,tcolorbox,caption,enumitem,ragged2e}
\RequirePackage{paracol}
\RequirePackage{needspace}
\RequirePackage{amsmath,amssymb}
\RequirePackage[hidelinks]{hyperref}
\tcbuselibrary{skins,breakable}

% ---------------------------------------------------------------- colour
\definecolor{navy}{HTML}{1F3864}
\definecolor{midblue}{HTML}{2A78D6}
\definecolor{lblue}{HTML}{DCE7F6}
\definecolor{palegrey}{HTML}{F4F5F7}
\definecolor{brick}{HTML}{C0392B}
\definecolor{palebrick}{HTML}{FBEDEB}
\definecolor{forest}{HTML}{1E8E5A}
\definecolor{palegreen}{HTML}{E8F4EE}
\definecolor{amber}{HTML}{EDA100}
\definecolor{paleamber}{HTML}{FDF4E0}
\definecolor{ash}{HTML}{7F7F7F}
\definecolor{ink}{HTML}{14161A}
\definecolor{rule}{HTML}{D8DBE0}

% ---------------------------------------------------------------- text
\setlength{\parindent}{0pt}
\setlength{\parskip}{4.2pt}
\linespread{1.045}
\setlength{\emergencystretch}{3em}
\hyphenpenalty=180 \clubpenalty=9000 \widowpenalty=9000
\color{ink}

% ---------------------------------------------------------------- columns
\columnratio{0.545}
\setlength{\columnsep}{7mm}

% ---------------------------------------------------------------- headings
\titleformat{\section}{\color{navy}\large\bfseries}{\thesection\quad}{0pt}{}
  [{\vspace{1pt}\color{navy}\titlerule[1.0pt]}]
\titleformat{\subsection}{\color{navy}\normalsize\bfseries}{\thesubsection\quad}{0pt}{}
\titleformat{\subsubsection}[runin]{\bfseries\itshape\color{ink}}{}{0pt}{}[.\;]
\titlespacing{\section}{0pt}{11pt}{5pt}
\titlespacing{\subsection}{0pt}{9pt}{3pt}
\titlespacing{\subsubsection}{0pt}{6pt}{4pt}

% ---------------------------------------------------------------- headers
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0pt}
% \runhead{part label}  — text-only header (used by the appendix)
\newcommand{\runhead}[1]{%
  \renewcommand{\headrulewidth}{0.6pt}%
  \fancyhead[L]{\scriptsize\color{ash}\textsc{#1}}%
  \fancyhead[R]{\scriptsize\color{ash} Cement Sector \textbar\ Business Analysis \& Valuation \textbar\ \thepage}}

% \runheadlogo{logo file in fig/}{part label} — puts the company mark on EVERY
% page of that company's part. Drop a real logo PNG in at fig/<name>.png and
% recompile to swap it in; nothing else changes.
\newcommand{\runheadlogo}[2]{%
  \renewcommand{\headrulewidth}{0.6pt}%
  \fancyhead[L]{\raisebox{-1.5mm}{\includegraphics[height=4.0mm]{fig/#1}}}%
  \fancyhead[R]{\scriptsize\color{ash}\textsc{#2} \textbar\ Business Analysis \& Valuation \textbar\ \thepage}}
\renewcommand{\headrule}{\hbox to\headwidth{\color{rule}\leaders\hrule height 0.6pt\hfill}}

% ---------------------------------------------------------------- callouts
\newtcolorbox{keybox}[1][]{colback=lblue!55,colframe=navy,boxrule=0pt,leftrule=2.4pt,
  arc=0pt,left=5pt,right=5pt,top=4pt,bottom=4pt,boxsep=1pt,
  before skip=6pt,after skip=7pt,breakable,#1}
\newtcolorbox{warnbox}[1][]{colback=palebrick,colframe=brick,boxrule=0pt,leftrule=2.4pt,
  arc=0pt,left=5pt,right=5pt,top=4pt,bottom=4pt,boxsep=1pt,
  before skip=6pt,after skip=7pt,breakable,#1}
\newtcolorbox{okbox}[1][]{colback=palegreen,colframe=forest,boxrule=0pt,leftrule=2.4pt,
  arc=0pt,left=5pt,right=5pt,top=4pt,bottom=4pt,boxsep=1pt,
  before skip=6pt,after skip=7pt,breakable,#1}
\newtcolorbox{notebox}[1][]{colback=paleamber,colframe=amber,boxrule=0pt,leftrule=2.4pt,
  arc=0pt,left=5pt,right=5pt,top=4pt,bottom=4pt,boxsep=1pt,
  before skip=6pt,after skip=7pt,breakable,#1}
\newcommand{\boxtitle}[1]{{\bfseries\color{navy}#1}\\[1.5pt]}
\newcommand{\boxtitler}[1]{{\bfseries\color{brick}#1}\\[1.5pt]}
\newcommand{\boxtitleg}[1]{{\bfseries\color{forest}#1}\\[1.5pt]}
\newcommand{\boxtitlea}[1]{{\bfseries\color{amber!75!black}#1}\\[1.5pt]}

% ---------------------------------------------------------------- exhibits
% \ex{file}{caption}{source}
\newcommand{\ex}[2]{%
  \par\addvspace{4pt}\needspace{3\baselineskip}%
  \noindent\begin{minipage}{\linewidth}
    \centering\includegraphics[width=\linewidth]{fig/#1}\par\vspace{2.5pt}
    \RaggedRight\scriptsize\color{ash}#2\par
  \end{minipage}\par\addvspace{8pt}}

% table block in the exhibit column
\newenvironment{extab}[2]{%
  \par\addvspace{5pt}\needspace{4\baselineskip}%
  \noindent{\footnotesize\bfseries\color{navy}#1}\par\vspace{2.5pt}%
  \gdef\extabsrc{#2}\footnotesize}
  {\par\vspace{2.5pt}{\scriptsize\color{ash}\RaggedRight\extabsrc\par}\addvspace{9pt}}

\newcommand{\hrow}{\rowcolor{navy}}
\newcommand{\arow}{\rowcolor{palegrey}}
\newcommand{\trow}{\rowcolor{lblue}}
\newcommand{\wh}[1]{{\color{white}\bfseries #1}}


% ---------------------------------------------------------------- people
% \person{width}{file}{name}{role}
\newcommand{\person}[4]{%
  \begin{minipage}[t]{#1}\centering
    \includegraphics[width=\linewidth]{fig/people/#2}\par\vspace{2.2pt}
    {\fontsize{6.6}{7.4}\selectfont\bfseries\color{ink}#3\par}\vspace{0.8pt}
    {\fontsize{5.5}{6.2}\selectfont\color{ash}#4\par}
  \end{minipage}}

% \product{width}{file}{name}{blurb}
\newcommand{\product}[4]{%
  \begin{minipage}[b]{#1}\centering
    \includegraphics[width=\linewidth,height=26mm,keepaspectratio]{fig/products/#2}\par\vspace{2.5pt}
    {\fontsize{6.8}{7.6}\selectfont\bfseries\color{navy}#3\par}\vspace{1pt}
    {\fontsize{5.6}{6.5}\selectfont\color{ash}#4\par}
  \end{minipage}}

% full-width section head used on the break-out pages
\newcommand{\fullhead}[2]{%
  \noindent{\color{navy}\large\bfseries #1}\par\vspace{1pt}
  {\color{navy}\rule{\textwidth}{1.0pt}}\par\vspace{1.5pt}
  {\footnotesize\color{ash}#2\par}\vspace{4mm}}

% ---------------------------------------------------------------- misc

\newcommand{\up}{\color{forest}$\blacktriangle$}
\newcommand{\dn}{\color{brick}$\blacktriangledown$}
\newcommand{\PASS}{{\color{forest}\bfseries PASS}}
\newcommand{\PART}{{\color{amber!75!black}\bfseries PARTIAL}}
\newcommand{\FAIL}{{\color{brick}\bfseries FAIL}}
\newcommand{\lead}[1]{{\bfseries\color{navy}#1}}

% recommendation banner
% \banner{Company}{Ticker}{stance}{target}{price}{up/down}{basis}
\newcommand{\banner}[7]{%
\noindent\colorbox{navy}{\parbox{\dimexpr\textwidth-2\fboxsep}{\vspace{3pt}
  {\color{white}\LARGE\bfseries #1}\hfill{\color{lblue}\normalsize #2}\vspace{4pt}}}\\[1.5pt]
\noindent\colorbox{brick}{\parbox{\dimexpr\textwidth-2\fboxsep}{\vspace{2.5pt}
  {\color{white}\normalsize\bfseries #3}\hfill
  {\color{white}\small Value \textbf{#4} \ \textbar\ \ Price #5 \ \textbar\ \ #6 \ \textbar\ \ #7}\vspace{3pt}}}\\[8pt]}

% part divider
\newcommand{\partpage}[3]{%
\thispagestyle{empty}\null\vspace*{34mm}
{\color{ash}\large\bfseries #1}\\[3mm]
{\color{navy}\fontsize{30}{34}\selectfont\bfseries #2}\\[5mm]
{\color{rule}\rule{\linewidth}{2.4pt}}\\[5mm]
\begin{minipage}{0.78\textwidth}\RaggedRight\large\color{ink}#3\end{minipage}
\vfill\newpage}

% stat strip: \stat{label}{value}
\newcommand{\stat}[2]{%
\begin{minipage}[t]{0.245\textwidth}\raggedright
{\scriptsize\color{ash}#1}\\[1pt]{\normalsize\bfseries\color{navy}#2}
\end{minipage}\hfill}
