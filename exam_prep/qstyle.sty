% ======================================================================
%  qstyle.sty — handwritten-notebook style MCQ question bank
% ======================================================================
\ProvidesPackage{qstyle}[2026/08/30 Handwritten MCQ sheet]

\RequirePackage[a4paper,left=24mm,right=13mm,top=17mm,bottom=15mm,
                headsep=4mm,headheight=15pt,footskip=8mm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{comicneue}
\RequirePackage{amsmath,amssymb}
\RequirePackage{graphicx,xcolor,array,enumitem,ragged2e}
\RequirePackage{tikz,eso-pic,fancyhdr,tcolorbox,needspace}
\tcbuselibrary{skins,breakable}
\renewcommand{\familydefault}{\sfdefault}

% ---------------------------------------------------------------- colour
\definecolor{inkblue}{HTML}{1A2E6E}     % pen
\definecolor{inkred}{HTML}{B4232A}      % correction pen
\definecolor{inkgreen}{HTML}{1B6B3A}
\definecolor{rulefaint}{HTML}{C9DCEF}   % notebook rule
\definecolor{marginred}{HTML}{E8A9AE}   % margin line
\definecolor{hiyellow}{HTML}{FFF2A8}    % highlighter
\definecolor{higreen}{HTML}{D6F0DC}
\definecolor{paper}{HTML}{FDFDF8}
\definecolor{pencil}{HTML}{6E6E6E}

% ---------------------------------------------------------------- paper
\newlength{\ruleskip}\setlength{\ruleskip}{5.6mm}
\AddToShipoutPictureBG{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[paper] (current page.south west) rectangle (current page.north east);
    \foreach \i in {1,...,50}{%
      \draw[rulefaint,line width=0.35pt]
        ([shift={(0mm,-\i\ruleskip-12mm)}]current page.north west) --
        ([shift={(0mm,-\i\ruleskip-12mm)}]current page.north east);}
    \draw[marginred,line width=0.7pt]
      ([shift={(20mm,0)}]current page.north west) --
      ([shift={(20mm,0)}]current page.south west);
  \end{tikzpicture}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt}
\linespread{1.06}
\color{inkblue}
\setlength{\emergencystretch}{3em}
\hyphenpenalty=200 \clubpenalty=9000 \widowpenalty=9000

% ---------------------------------------------------------------- header
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[L]{\footnotesize\color{pencil}\itshape BAV — Business Analysis \& Valuation}
\fancyhead[R]{\footnotesize\color{pencil}\itshape page \thepage}

% ------------------------------------------------------------ structures
% \sect{letter}{title}{blurb}
\newcommand{\sect}[3]{%
  \par\addvspace{7mm}\needspace{5\baselineskip}%
  \noindent\begin{tikzpicture}
    \node[fill=inkblue,text=white,font=\bfseries\large,inner xsep=7pt,inner ysep=3.5pt]
      (a) {SECTION #1};
    \node[anchor=west,font=\bfseries\large,text=inkblue,xshift=4mm] at (a.east) {#2};
  \end{tikzpicture}\par\vspace{1mm}
  {\footnotesize\color{pencil}\itshape #3\par}\vspace{3mm}}

% question number in a hand-drawn circle
\newcommand{\qnum}[1]{%
  \begin{tikzpicture}[baseline=(n.base)]
    \node[draw=inkred,line width=0.9pt,circle,inner sep=1.4pt,minimum size=7.5mm,
          font=\bfseries\small,text=inkred] (n) {#1};
  \end{tikzpicture}}

% \q{num}{topic}{question}
\newcommand{\q}[3]{%
  \par\addvspace{5mm}\needspace{7\baselineskip}%
  \noindent\begin{minipage}[t]{0.072\textwidth}\qnum{#1}\end{minipage}%
  \begin{minipage}[t]{0.925\textwidth}\vspace{1mm}
    {\scriptsize\color{pencil}\itshape #2}\par\vspace{0.6mm}#3
  \end{minipage}\par\vspace{1.5mm}}

% four options, two per line
\newcommand{\opt}[4]{%
  \noindent\hspace{7mm}%
  \begin{minipage}[t]{0.455\textwidth}(a)~#1\end{minipage}\hfill
  \begin{minipage}[t]{0.455\textwidth}(b)~#2\end{minipage}\par\vspace{0.8mm}
  \noindent\hspace{7mm}%
  \begin{minipage}[t]{0.455\textwidth}(c)~#3\end{minipage}\hfill
  \begin{minipage}[t]{0.455\textwidth}(d)~#4\end{minipage}\par\vspace{2mm}}

% worked solution
\newenvironment{soln}{%
  \par\vspace{1mm}\needspace{3\baselineskip}%
  \noindent\hspace{7mm}\begin{minipage}{0.93\textwidth}
  {\color{inkred}\bfseries Working.}~\ignorespaces}
  {\end{minipage}\par\vspace{1.5mm}}

% highlighted answer
\newcommand{\ans}[2]{%
  \par\noindent\hspace{7mm}%
  \tcbox[on line,colback=hiyellow,colframe=hiyellow,boxrule=0pt,arc=1pt,
         left=5pt,right=5pt,top=2pt,bottom=2pt]{%
    {\color{inkred}\bfseries Ans: (#1)}~{\color{inkblue}#2}}\par\vspace{1mm}}

% a remembered rule / margin note
\newcommand{\memo}[1]{%
  \par\noindent\hspace{7mm}\begin{minipage}{0.93\textwidth}
  {\color{inkgreen}\bfseries$\star$ Remember.}~{\color{inkgreen}#1}\end{minipage}\par\vspace{1mm}}

\newcommand{\formula}[1]{%
  \par\vspace{0.8mm}\noindent\hspace{10mm}%
  \tcbox[on line,colback=higreen,colframe=inkgreen!45,boxrule=0.5pt,arc=1.5pt,
         left=6pt,right=6pt,top=2.5pt,bottom=2.5pt]{#1}\par\vspace{1mm}}
